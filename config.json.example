{
  "schema_version": 2,
  "server": {
    "bind": "127.0.0.1:10101",
    "auth": {
      "mode": "none",
      "token_env": "ARIOSO_TOKEN"
    },
    "first_message_timeout_ms": 10000,
    "tls": {
      "cert": null,
      "key": null
    },
    "limits": {
      "requests_per_second": 50,
      "burst": 100,
      "max_connections": 512,
      "header_timeout_ms": 10000,
      "max_text_chars": 4000,
      "idle_timeout_ms": 30000,
      "shutdown_grace_ms": 5000
    },
    "trust_forwarded_for": false,
    "docs": true,
    "sidecar": false
  },
  "tts": {
    "enabled": true,
    "engine": "piper",
    "voice": null,
    "speed": 1.0,
    "sid": 0,
    "format": "wav",
    "dictionary": null,
    "time_of_day": true
  },
  "stt": {
    "enabled": true,
    "engine": "sherpa",
    "batch_model": "sherpa-parakeet-tdt-0.6b-v2-en",
    "stream_model": "",
    "language": "auto",
    "partials": true,
    "partial_interval_ms": 300,
    "stability_window_ms": 200,
    "word_timestamps": false,
    "max_audio_s": 600,
    "capture": {
      "mode": "separate",
      "sources": [
        "mic"
      ],
      "loopback_device": null
    }
  },
  "vad": {
    "engine": "energy",
    "threshold": 0.01,
    "frame_ms": 32,
    "min_speech_ms": 250,
    "min_silence_ms": 700,
    "padding_ms": 200,
    "max_segment_ms": 30000
  },
  "audio": {
    "output": "api",
    "device": null,
    "queue_ms": 2000
  },
  "models": {
    "dir": null,
    "mirror": null,
    "max_concurrent_downloads": 2,
    "auto_download": [],
    "ca_bundle": null
  },
  "log": {
    "level": "error",
    "format": "pretty",
    "file": null,
    "retention_days": 7,
    "log_text": false
  },
  "env": {}
}
